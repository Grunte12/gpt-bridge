# Local-only Docker setup
#
# 1. Copy this file to .env
# 2. Replace the placeholder below with a long random value.
#    PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# 3. Keep .env private; it is intentionally ignored by Git.

CHATGPT_API_KEY=REPLACE_WITH_A_LONG_RANDOM_LOCAL_SECRET

# The Docker ports bind to 127.0.0.1 only. Do not change this project into a
# public or LAN service without adding a deliberate network-security design.
CHATGPT_API_PORT=8000
BRIDGE_CONSOLE_PORT=8080
CHATGPT_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Optional: pin one or more already-saved local account aliases. Leave blank
# to auto-discover captures under ./secrets/accounts.
CHATGPT_ACCOUNT=
CHATGPT_ACCOUNTS=
CHATGPT_ACCOUNT_STRATEGY=failover
